# Tenda BE12 Pro — 增量配置
# 基底: defconfig/low-mem-512m/mt7987-mt7992-be7200.config
# 基底已包含: tenda_be12-pro 设备、MT7992 Wi-Fi 7 驱动栈、turboacc、argon 主题、zram 等

CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tenda_be12-pro=y

# LuCI 与中文语言包
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y

# OpenClash
CONFIG_PACKAGE_luci-app-openclash=y

# clash 内核 + GeoIP 数据
# OpenClash 0.48+ 的 DEPENDS 已不再包含 mihomo，必须显式声明，否则固件里没有内核，
# 只能靠 OpenClash 运行时从 GitHub 拉取（国内网络经常失败）。
CONFIG_PACKAGE_mihomo=y
CONFIG_PACKAGE_v2ray-geoip=y

# iStore 软件中心 + 其依赖链
# luci-app-store 依赖: curl tar libuci-lua mount-utils luci-lib-taskd
# luci-lib-taskd 依赖: luci-lib-xterm taskd
# taskd 依赖: procd script-utils coreutils coreutils-stty
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_mount-utils=y
# luci-app-store 的 kconfig 里有: depends on !(PACKAGE_TAR_XZ) || PACKAGE_xz-utils
# tar 若带 XZ 支持而 xz-utils 未选中，该条件为假，整个符号会被 kconfig 隐藏
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_script-utils=y
CONFIG_PACKAGE_coreutils-stty=y

# 常用依赖（OpenClash 运行需要）
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# 编译加速
CONFIG_CCACHE=y
